{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@shared/*": ["./shared/*"],
      "@game/*": ["./src/game/*"],
      "@components/*": ["./src/components/*"],
      "@engine/*": ["./src/engine/*"],
      "@art/*": ["./src/art/*"],
      "@audio/*": ["./src/audio/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "shared/**/*.ts",
    "server/**/*.ts",
    "tests/**/*.ts",
    "tools/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
